{
  // The sync service (M15). Type checks only (`pnpm check`), tests included (not in tsconfig.test.json): esbuild bundles it for the webspace
  // (`pnpm build:server`, server/README.md). Erasable syntax only, so esbuild's plain type stripping is all it needs.
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"],
  "exclude": ["dist"]
}
