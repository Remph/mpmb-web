# Settings for the app's own folder on the live site (Apache). Each block is skipped when its
# module is missing, so the file never breaks the site.

<IfModule mod_headers.c>
  # Cross-origin isolation for the engine worker: it waits for the answers to the sheet's pop-ups
  # with shared memory, which browsers only allow on isolated pages. "always" puts them on every
  # answer, also 304 Not Modified and errors, whatever the Apache version: Safari refused a cached
  # worker script whose 304 lacked COEP (seen with vite preview).
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"

  # What the page and the engine worker may load and contact (Content Security Policy). A sheet's
  # add-on scripts run in the worker (src/worker/lockdown.ts); with connect-src and script-src limited
  # to this site they can't send a character elsewhere or load code from elsewhere. The worker starts
  # from a blob: URL and so takes this page's policy: hence worker-src blob: (and blob: in script-src,
  # which Safari before 15.5 reads for workers instead), and 'unsafe-eval'
  # because MPMB's scripts run through eval, as in Acrobat. Svelte sets style attributes, hence
  # 'unsafe-inline' for styles only. vite.config.ts reads this line, so `pnpm preview` sends it too.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

  # The page itself is checked on every visit, so a new version shows up at once...
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # ...while the build's files carry a content hash in their name ("index-CH5oqtRN.js"): a new
  # version has new names, so the old ones can stay cached for good.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# The engine is a 5 MB script; compressed it is about 1.2 MB.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
