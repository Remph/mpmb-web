# Settings for the app's own folder on the live site (Apache). Each block is skipped when its
# module is missing, so the file never breaks the site.

<IfModule mod_headers.c>
  # Cross-origin isolation for the engine worker: it waits for the answers to the sheet's pop-ups
  # with shared memory, which browsers only allow on isolated pages. "always" puts them on every
  # answer, also 304 Not Modified and errors, whatever the Apache version: Safari refused a cached
  # worker script whose 304 lacked COEP (seen with vite preview).
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"

  # What the page and the engine worker may load and contact (Content Security Policy). A sheet's
  # add-on scripts run in the worker (src/worker/lockdown.ts); with connect-src and script-src limited
  # to this site they can't send a character elsewhere or load code from elsewhere. The worker starts
  # from a blob: URL and so takes this page's policy: hence worker-src blob: (and blob: in script-src,
  # which Safari before 15.5 reads for workers instead), and 'unsafe-eval'
  # because MPMB's scripts run through eval, as in Acrobat. Svelte sets style attributes, hence
  # 'unsafe-inline' for styles only. The page also talks to the sync service (M15, src/sync/api.ts), on
  # its own subdomain; the worker can't, since lockdown.ts takes fetch away before a script runs.
  # script-src names the app's own folder rather than 'self' (all of remph.de): no script from another
  # part of the site can be loaded by the page or by an add-on script. Under both host names, because a
  # page opened as www.remph.de/mpmb/ (if the host serves it without a redirect) would otherwise load no
  # script at all and its characters, kept per host name, would seem gone. form-action: the app posts no
  # forms. (Security audit 2026-11-20, finding 11. HSTS and nosniff come from remph.de's root
  # .htaccess for the whole domain; this file doesn't repeat them.)
  # vite.config.ts reads this line, so `pnpm preview` sends it too (with 'self' for the folder, since
  # it runs on localhost); the deploy checks that remph.de sends exactly this one.
  Header always set Content-Security-Policy "default-src 'self'; script-src https://remph.de/mpmb/ https://www.remph.de/mpmb/ 'unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' https://sync.remph.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"

  # The page itself is checked on every visit, so a new version shows up at once (so are the service
  # worker, which stores the app for offline use, the web app manifest, and look.js, which sets the
  # theme before the page paints and has no hash in its name)...
  <FilesMatch "(\.html|\.webmanifest|^sw\.js|^look\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # ...while the build's files carry a content hash in their name ("index-CH5oqtRN.js"): a new
  # version has new names, so the old ones can stay cached for good.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# The web app manifest's type, which older Apache setups don't know yet.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# The engine is a 5 MB script; compressed it is about 1.2 MB.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
