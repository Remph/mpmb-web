{
  // The service worker (src/offline/sw.ts) runs where there is no page: it gets the worker's types
  // (ServiceWorkerGlobalScope, caches, FetchEvent) instead of the page's, which would clash with them.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/offline/sw.ts"]
}
